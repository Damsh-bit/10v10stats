NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Apuestas (ver docs/apuestas.md) ─────────────────────────────────────────
# true = activas · preview = se ven las cuotas sin poder apostar · vacío = apagadas
APUESTAS_HABILITADAS=
# Firma de la cookie de sesión de cada jugador (32+ caracteres al azar).
APUESTAS_SESSION_SECRET=
# Clave del panel de la banca (12+ caracteres).
APUESTAS_ADMIN_KEY=
# URL pública del sitio (para el webhook y la vuelta del checkout). En Vercel se deduce sola.
APUESTAS_SITE_URL=
# Montos en pesos enteros.
APUESTAS_MONTO_MIN=500
APUESTAS_MONTO_MAX=50000
# Comisión de Mercado Pago que paga cada apostador encima, en porcentaje (la de tu cuenta según el plazo de
# acreditación). 0 = la absorbe la banca.
APUESTAS_RECARGO_PCT=0

# Mercado Pago (Checkout Pro). Con el token de prueba (TEST-…) se usan usuarios de prueba.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook ("Tus integraciones" → Webhooks) para validar la firma.
MERCADOPAGO_WEBHOOK_SECRET=
# true = manda al sandbox_init_point (sólo para probar con credenciales de prueba).
MERCADOPAGO_USE_SANDBOX=

# Sin Mercado Pago: modo manual, cada uno transfiere a este alias y el admin confirma.
APUESTAS_BANCA_ALIAS=
